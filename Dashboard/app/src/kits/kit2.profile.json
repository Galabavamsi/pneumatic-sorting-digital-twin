{
  "id": "kit2",
  "name": "Kit 2",
  "title": "Two-station stamp and sort",
  "description": "Feeds a part to Stamp A, where two sensors tell metal from plastic. Metal is stamped at A and pushed on into Bin 1; plastic is moved across to Stamp B, stamped there and pushed into Bin 2. Kit 2 has no PLC program or wiring yet, so this station only exists as a simulation, following the Unity twin's sequence.",
  "steps": [
    { "id": 0, "name": "Idle" },
    { "id": 10, "name": "Waiting for a part" },
    { "id": 11, "name": "Feed to Stamp A" },
    { "id": 12, "name": "Feed back" },
    { "id": 13, "name": "Detect material" },
    { "id": 20, "name": "Stamp A down" },
    { "id": 21, "name": "Stamp A up" },
    { "id": 22, "name": "Eject to Bin 1" },
    { "id": 23, "name": "Feed back" },
    { "id": 30, "name": "Transfer to Stamp B" },
    { "id": 31, "name": "Transfer back" },
    { "id": 32, "name": "Stamp B down" },
    { "id": 33, "name": "Stamp B up" },
    { "id": 34, "name": "Eject to Bin 2" },
    { "id": 35, "name": "Transfer back" },
    { "id": 40, "name": "Part counted" },
    { "id": 90, "name": "Fault" }
  ],
  "sequence": [11, 12, 13, 20, 21, 22, 23, 30, 31, 32, 33, 34, 35, 40],
  "faults": {
    "1": "Emergency stop pressed",
    "2": "Feed cylinder did not reach Stamp A",
    "3": "Transfer cylinder did not reach Stamp B"
  },
  "counters": [
    { "id": "parts", "label": "Parts sorted", "var": "parts" },
    { "id": "metal", "label": "Metal · Bin 1", "var": "metal" },
    { "id": "plastic", "label": "Plastic · Bin 2", "var": "plastic" }
  ],
  "inputs": [
    { "id": "IN-1", "label": "Part in magazine", "var": "DI_MagazinePartPresent" },
    { "id": "IN-2", "label": "Part at Stamp A", "var": "DI_PartAtStampA" },
    { "id": "IN-3", "label": "Part at Stamp B", "var": "DI_PartAtStampB" },
    { "id": "IN-4", "label": "Metal detected", "var": "DI_MetalDetected" },
    { "id": "IN-5", "label": "Plastic detected", "var": "DI_CapacitiveDetected" },
    { "id": "IN-6", "label": "Feed home", "var": "DI_FeedHome" },
    { "id": "IN-7", "label": "Feed at Stamp A", "var": "DI_FeedStage" },
    { "id": "IN-8", "label": "Feed at eject", "var": "DI_FeedEject" },
    { "id": "IN-9", "label": "Transfer home", "var": "DI_TransferHome" },
    { "id": "IN-10", "label": "Transfer at Stamp B", "var": "DI_TransferStage" },
    { "id": "IN-11", "label": "Transfer at eject", "var": "DI_TransferEject" },
    { "id": "IN-12", "label": "Stamp A up", "var": "DI_StampAUp" },
    { "id": "IN-13", "label": "Stamp A down", "var": "DI_StampADown" },
    { "id": "IN-14", "label": "Stamp B up", "var": "DI_StampBUp" },
    { "id": "IN-15", "label": "Stamp B down", "var": "DI_StampBDown" },
    { "id": "IN-16", "label": "Air and power ready", "var": "DI_UtilityReady" }
  ],
  "outputs": [
    { "id": "OUT-1", "label": "Feed home", "var": "DO_FeedHome" },
    { "id": "OUT-2", "label": "Feed to Stamp A", "var": "DO_FeedStage" },
    { "id": "OUT-3", "label": "Feed eject", "var": "DO_FeedEject" },
    { "id": "OUT-4", "label": "Transfer home", "var": "DO_TransferHome" },
    { "id": "OUT-5", "label": "Transfer to Stamp B", "var": "DO_TransferStage" },
    { "id": "OUT-6", "label": "Transfer eject", "var": "DO_TransferEject" },
    { "id": "OUT-7", "label": "Stamp A down", "var": "DO_StampADown" },
    { "id": "OUT-8", "label": "Stamp B down", "var": "DO_StampBDown" }
  ],
  "actuators": [
    { "id": "FEED", "label": "Feed cylinder", "kind": "linear", "a": { "var": "DO_FeedEject", "label": "Eject" }, "b": { "var": "DO_FeedHome", "label": "Home" } },
    { "id": "XFER", "label": "Transfer cylinder", "kind": "linear", "a": { "var": "DO_TransferEject", "label": "Eject" }, "b": { "var": "DO_TransferHome", "label": "Home" } },
    { "id": "SA", "label": "Stamp A", "kind": "linear", "a": { "var": "DO_StampADown", "label": "Down" }, "b": { "var": null, "label": "Up" } },
    { "id": "SB", "label": "Stamp B", "kind": "linear", "a": { "var": "DO_StampBDown", "label": "Down" }, "b": { "var": null, "label": "Up" } }
  ],
  "settings": [
    { "label": "Feed stroke to Stamp A", "var": "feedStage", "unit": "mm" },
    { "label": "Feed stroke to eject", "var": "feedEject", "unit": "mm" },
    { "label": "Transfer stroke to Stamp B", "var": "transferStage", "unit": "mm" },
    { "label": "Stamp stroke", "var": "stampStroke", "unit": "mm" }
  ]
}
